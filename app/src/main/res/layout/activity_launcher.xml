<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".ui.LauncherActivity">

    <!-- Main Workspace Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/workspace_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- At-a-Glance Smart Widget -->
        <LinearLayout
            android:id="@+id/at_a_glance_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/at_a_glance_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/at_a_glance_title"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                tools:text="Tuesday, Sep 22" />

            <TextView
                android:id="@+id/at_a_glance_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/at_a_glance_sub"
                android:textSize="15sp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="@string/app_name" />

        </LinearLayout>

        <!-- Interactive Multi-Page Desktop Workspace (ViewPager2) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/workspace_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/at_a_glance_container"
            app:layout_constraintBottom_toTopOf="@id/hotseat_dock_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Hotseat Dock Container -->
        <LinearLayout
            android:id="@+id/hotseat_dock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Pill Dock Container -->
            <FrameLayout
                android:id="@+id/dock_pill_container"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/dock_background_shape"
                android:elevation="4dp">

                <!-- Multi-Page Scrollable Dock ViewPager2 -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/dock_view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </FrameLayout>

            <!-- Adaptive Material 3 Monochrome Indicators -->
            <org.lineageos.launcher.dock.DockPageIndicator
                android:id="@+id/dock_indicators"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <!-- Bottom Quick Search Box (QSB) -->
            <LinearLayout
                android:id="@+id/qsb_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/qsb_background_shape"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/qsb_text"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/search_apps"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_open_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/qsb_text"
                    android:contentDescription="@string/settings_title"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Modern App Drawer BottomSheet (GrapheneOS / LineageOS style) -->
    <LinearLayout
        android:id="@+id/app_drawer_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/drawer_background_shape"
        android:paddingTop="12dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/drawer_handle_shape" />

        <!-- Drawer Search Input -->
        <EditText
            android:id="@+id/drawer_search_input"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/qsb_background_shape"
            android:hint="@string/search_apps"
            android:textColorHint="@color/on_surface_variant"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <!-- Profile Tabs (All, Work, Private Space) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/drawer_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="@color/on_surface_variant"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <!-- All Apps Grid Container with FastScroller -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- All Apps Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="28dp"
                android:clipToPadding="false" />

            <!-- Alphabetical Fast Scroller (A-Z) -->
            <org.lineageos.launcher.ui.FastScrollerView
                android:id="@+id/drawer_fast_scroller"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Floating Letter Indicator Bubble -->
            <TextView
                android:id="@+id/drawer_fast_scroll_popup"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/qsb_background_shape"
                android:gravity="center"
                android:textColor="@color/on_surface"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:elevation="12dp" />

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
